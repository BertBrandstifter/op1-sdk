{
  "schema": 1,
  "name": "shimmer",
  "title": "SHIMMER effect (reverb whose tail rises an interval each pass)",
  "version": "0.2",
  "status": "sim-verified",
  "firmware": {
    "R246": "c5315218f825f143b415ca554516541898abee843d3a236df0b54c04e1fb13a9"
  },
  "sdk": 1,
  "prefix": [
    "sh_"
  ],
  "summary": "Pick SHIMMER in TE's FX list: a 4-line reverb with a pitch shifter inside its loop, so the tail climbs an octave (or +7, +19, +24, -12) on every pass. DECAY, TONE, SHIMMER, MIX on the FX knobs; INTERVAL, SIZE, MOD, LOWCUT on page 2 (knob push). Works as synth, drum and master FX (master: wide stereo tail). Hosted on spring with an in-range marker in fx_params 5-8: presets pass TE's checks and load on stock firmware as spring.",
  "license": "MIT",
  "authors": [
    "unknown"
  ],
  "docs": "README.md",
  "sources": [
    "shimmer.c",
    "shimmer_core.c"
  ],
  "libs": [
    "gfx"
  ],
  "cflags": [
    "-O2"
  ],
  "shared": [
    {
      "point": "on_key",
      "fn": "sh_key",
      "mode": "filter"
    },
    {
      "point": "on_knob",
      "fn": "sh_knob",
      "mode": "filter"
    },
    {
      "point": "frame",
      "fn": "sh_frame"
    },
    {
      "point": "fx_name",
      "fn": "sh_te_fx_fetched"
    },
    {
      "point": "master_fx_name",
      "fn": "sh_te_master_fetched"
    },
    {
      "point": "fx_patch",
      "fn": "sh_te_fx_patch"
    },
    {
      "point": "fx_current_name",
      "fn": "sh_te_fx_current"
    },
    {
      "point": "master_fx_current_name",
      "fn": "sh_te_master_current"
    }
  ],
  "hooks": {
    "pointers": [
      {
        "addr": "0x019113d0",
        "expect": "0x01a326e8",
        "c": "sh_te_mono",
        "what": "spring mono process (synth / drum FX)"
      },
      {
        "addr": "0x019113f0",
        "expect": "0x01a32ffc",
        "c": "sh_te_stereo",
        "what": "spring stereo process (master FX)"
      }
    ]
  },
  "content_sql": [
    {
      "file": "content/op1_factory.db",
      "sql": [
        "INSERT INTO fx_types (id, type, default_params) SELECT MAX(id) + 1, 'shimmer', '[9651, 12966, 8192, 13000, 16384, 22118, 18841, 18432]' FROM fx_types"
      ]
    }
  ],
  "controls": [
    "FX list: SHIMMER",
    "synth FX screen, SHIMMER: knob push flips page 1 (DECAY TONE SHIMMER MIX) / page 2 (INTERVAL SIZE MOD LOWCUT)",
    "mixer FX page (master FX = SHIMMER, on): same SHIMMER page, knob push = page 2"
  ],
  "tests": [
    "test_shimmer_core.c",
    "sim/run_shtest.py"
  ],
