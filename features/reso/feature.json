{
  "schema": 1,
  "name": "reso",
  "title": "RESO effect (strings tuned to the played notes)",
  "version": "0.3",
  "status": "sim-verified",
  "firmware": {
    "R246": "c5315218f825f143b415ca554516541898abee843d3a236df0b54c04e1fb13a9"
  },
  "sdk": 1,
  "prefix": [
    "rs_"
  ],
  "summary": "Pick RESO in TE's FX list: four resonating strings tuned to the notes the synth is playing (any source), with DECAY, TONE, CHORD voicing and MIX on the FX knobs and GLIDE, OCTAVE, DETUNE, DRIVE on page 2 (knob push). Works as synth, drum and master FX. Hosted on CWO with an in-range marker in fx_params 5-8: presets pass TE's checks and load on stock firmware as CWO.",
  "license": "MIT",
  "authors": [
    "unknown"
  ],
  "docs": "README.md",
  "sources": [
    "reso.c",
    "reso_core.c"
  ],
  "libs": [
    "gfx"
  ],
  "cflags": [
    "-O2"
  ],
  "shared": [
    {
      "point": "on_key",
      "fn": "rs_key",
      "mode": "filter"
    },
    {
      "point": "on_knob",
      "fn": "rs_knob",
      "mode": "filter"
    },
    {
      "point": "frame",
      "fn": "rs_frame"
    },
    {
      "point": "fx_name",
      "fn": "rs_te_fx_fetched"
    },
    {
      "point": "master_fx_name",
      "fn": "rs_te_master_fetched"
    },
    {
      "point": "fx_patch",
      "fn": "rs_te_fx_patch"
    },
    {
      "point": "fx_current_name",
      "fn": "rs_te_fx_current"
    },
    {
      "point": "master_fx_current_name",
      "fn": "rs_te_master_current"
    }
  ],
  "hooks": {
    "pointers": [
      {
        "addr": "0x0190f588",
        "expect": "0x0194480c",
        "c": "rs_te_mono",
        "what": "CWO mono process (synth / drum FX)"
      },
      {
        "addr": "0x0190f5a8",
        "expect": "0x019450fc",
        "c": "rs_te_stereo",
        "what": "CWO stereo process (master FX)"
      }
    ]
  },
  "content_sql": [
    {
      "file": "content/op1_factory.db",
      "sql": [
        "INSERT INTO fx_types (id, type, default_params) SELECT MAX(id) + 1, 'reso', '[20000, 22000, 0, 16384, 8192, 12288, 8192, 8192]' FROM fx_types"
      ]
    }
  ],
  "controls": [
    "FX list: RESO",
    "synth FX screen, RESO: knob push flips page 1 (DECAY TONE CHORD MIX) / page 2 (GLIDE OCTAVE DETUNE DRIVE)",
    "mixer FX page (master FX = RESO, on): same RESO page, knob push = page 2"
  ],
  "tests": [
    "test_reso_core.c",
    "sim/run_rstest.py"
  ],
  "depends": [],
  "conflicts": [],
  "status_note": "v0.3: own page + page 2 on the mixer's master FX page too; FX browsers keep the RESO row after confirm (fx_current_name); v0.2: shared fx_name points; v0.1: FX list entry on CWO",
  "claims": [
