  "hooks": {
    "entry_hooks": [
      {
        "func": "0x019de548",
        "expect": "600509e1bcda",
        "c": "py_bus_hook",
        "after": true,
        "what": "TE's metronome mix into the master bus (audio interrupt, every block, before master EQ / FX / drive / volume): after it, PLAY adds its sum into the int16 bus 0xff800d34 / 0xff800db4, so TE's master section acts on it like on the tape"
      }
    ],
    "call_sites": [
      {
        "site": "0x01997584",
        "expect": "0x01997de4",
        "c": "py_cleanup_hook",
        "what": "disk mode left without changes: before TE deletes the image's root entries, import play/"
      },
      {
        "site": "0x01996986",
        "expect": "0x01997de4",
        "c": "py_cleanup_hook",
        "what": "sync after a restart: before TE deletes the image's root entries, import play/"
      },
      {
        "site": "0x01996f6a",
        "expect": "0x01997de4",
        "c": "py_cleanup_hook",
        "what": "defragment check (every boot, and on the way out of disk mode): before its cleanup, import play/"
      }
    ]
  },
