{
  "schema": 1,
  "name": "play",
  "title": "PLAY tape screen",
  "version": "0.3.2",
  "status": "experimental",
  "summary": "The tape key opens PLAY, a second tape screen (TE's own 4-track tape: tape again): one list of up to 8 tracks, each AUDIO (a WAV / AIF from disk mode's play/ folder, looped or once, streamed from flash), SYNTH (NOTE ROLL patterns on its own instance of an SDK engine with one of the 8 synth sounds, TE's envelope, PLAY's decimator) or DRUM (DRUM ROLL patterns on PLAY's own sample player from TE's kits, in place), all sample-locked from bar 1, with level, mute, solo, master and a bar counter; the mix joins TE's master bus like the tape (master EQ, master FX, mixer drive and volume act on it). The track list lives in SONG.BIN (a tracker song: song rows x tracks, chains of patterns + transpose). When disk mode is left, a hook in TE's disk sync copies play/ into /yaffs2/user/play_a|play_b before TE clears the disk (the only writes, with SONG.BIN).",
  "license": "MIT",
  "authors": [
    "unknown"
  ],
  "sdk": 1,
  "firmware": {
    "R246": "c5315218f825f143b415ca554516541898abee843d3a236df0b54c04e1fb13a9"
  },
  "prefix": "py_",
