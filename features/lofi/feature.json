{
  "schema": 1,
  "name": "lofi",
  "title": "LOFI synth engine (chiptune + bytebeat)",
  "version": "0.7",
  "status": "sim-verified",
  "firmware": {
    "R246": "c5315218f825f143b415ca554516541898abee843d3a236df0b54c04e1fb13a9"
  },
  "sdk": 1,
  "prefix": [
    "lf_"
  ],
  "summary": "Pick LOFI in the engine list: chiptune waves (pulse, stepped triangle, saw, noise, metal, 4 wavetables) and 16 pitch-tracking bytebeat formulas, with shape, crush, bits, bend, arpeggio/loop, sweep and tone. 8 values (knob push = page 1/2) saved in the preset; TE's envelope, FX and LFO apply. The preset stays a pulse preset (loads on stock firmware as pulse).",
  "license": "MIT",
  "authors": [
    "unknown"
  ],
  "docs": "README.md",
  "sources": [
    "lofi.c",
    "lofi_core.c"
  ],
  "libs": [
    "gfx"
  ],
  "cflags": [
    "-O2"
  ],
  "shared": [
    {
      "point": "on_key",
      "fn": "lf_key",
      "mode": "filter"
    },
    {
      "point": "on_knob",
      "fn": "lf_knob",
      "mode": "filter"
    },
    {
      "point": "frame",
      "fn": "lf_frame"
    },
    {
      "point": "engine_name",
      "fn": "lf_te_type_fetched"
    }
  ],
  "hooks": {
    "pointers": [
      {
        "addr": "0x019111e0",
        "expect": "0xffa04b88",
        "c": "lf_te_render",
        "what": "pulse voice render"
      },
      {
        "addr": "0x019111e8",
        "expect": "0x01a0dee4",
        "c": "lf_te_note_on",
        "what": "pulse voice note_on"
      }
    ],
    "entry_hooks": [
      {
        "func": "0x01a1deb0",
        "expect": "810c0418",
        "to": "_lf_te_range_check",
        "what": "synth knob range check (patch validator): accept LOFI values in pulse slots 5-8"
      }
    ]
  },
  "controls": [
    "engine list: LOFI; preset browser: folder lofi (one preset, 'lofi'); the sounds are in the built-in bank (shift + blue turn)",
    "LOFI sound: knob push flips page 1 (WAVE SHAPE CRUSH BITS) / page 2 (BEND ARP-LOOP SWEEP TONE)",
    "LOFI sound: shift + blue turn browses the built-in bank (14 sounds)"
  ],
  "tests": [
    "test_lofi_core.c",
    "sim/run_lofitest.py"
  ],
  "depends": [],
